# Sentinel monorepo line-ending policy
* text=auto

# Source, configuration, documentation: canonical LF
*.kt       text eol=lf
*.kts      text eol=lf
*.java     text eol=lf
*.xml      text eol=lf
*.json     text eol=lf
*.toml     text eol=lf
*.md       text eol=lf
*.properties text eol=lf
*.sh       text eol=lf
*.service  text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf

# Unix Gradle launcher must remain LF
gradlew    text eol=lf

# Windows-native scripts
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf

# Binary assets
*.png      binary
*.jpg      binary
*.jpeg     binary
*.webp     binary
*.ico      binary
*.jar      binary
*.apk      binary
*.aab      binary
