{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sentinel Agent Error (Draft)",
  "type": "object",
  "required": [
    "protocolVersion",
    "messageType",
    "messageId",
    "timestamp",
    "senderId",
    "payload"
  ],
  "properties": {
    "protocolVersion": {
      "type": "string"
    },
    "messageType": {
      "const": "agent.error"
    },
    "messageId": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "senderId": {
      "type": "string"
    },
    "correlationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object",
      "required": [
        "component",
        "message"
      ],
      "properties": {
        "component": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "recoverable": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
