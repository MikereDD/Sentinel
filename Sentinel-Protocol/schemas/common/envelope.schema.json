{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typezero.local/sentinel/common/envelope.schema.json",
  "title": "Sentinel Message Envelope (Draft)",
  "type": "object",
  "required": [
    "protocolVersion",
    "messageType",
    "messageId",
    "timestamp",
    "senderId",
    "payload"
  ],
  "properties": {
    "protocolVersion": {
      "type": "string"
    },
    "messageType": {
      "type": "string"
    },
    "messageId": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "senderId": {
      "type": "string"
    },
    "correlationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {}
  },
  "additionalProperties": true
}
